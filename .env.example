# =============================================================
# Configuración del Gateway de Notificaciones de Telegram (Rust)
# =============================================================

# Token de bot obtenido con @BotFather en Telegram (REQUERIDO)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Chat ID inicial que recibirá las notificaciones (opcional)
TELEGRAM_CHAT_ID=

# Lista blanca de Telegram User IDs autorizados separados por coma.
# ⚠️ IMPORTANTE: si se deja VACÍO, NADIE puede usar el bot (silencio total).
# Los usuarios no listados son ignorados sin ninguna respuesta.
# Tu User ID lo obtienes con /id o preguntando a @userinfobot.
ALLOWED_USERS=

# Servidor HTTP local para recibir notificaciones (scripts, cron, monitores, CI/CD, etc.)
HTTP_HOST=127.0.0.1
HTTP_PORT=8088

# Archivo de persistencia de suscriptores
STORAGE_PATH=subscribers.json
